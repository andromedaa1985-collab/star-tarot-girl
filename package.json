{
  "name": "astrorail-tarot-girl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run clean && vite build",
    "build:android": "npm run clean && vite build --mode android",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "node scripts/clean-dist.cjs",
    "lint": "tsc --noEmit",
    "audit:tarot-randomness": "tsx scripts/audit-tarot-randomness.ts",
    "android:sync": "npm run build:android && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@google/genai": "^1.29.0",
    "@netlify/blobs": "^10.7.6",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "duck-duck-scrape": "^2.2.7",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "lunar-javascript": "^1.7.7",
    "motion": "^12.38.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^7.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.2",
    "serverless-http": "^4.0.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
