DEEPSEEK_API_KEY=
IMAGE_API_KEY=
AUTH_SESSION_SECRET=

# Public site URL used by payment callbacks and share/invite links, for example:
# PUBLIC_BASE_URL=https://your-domain.com
PUBLIC_BASE_URL=

# Third-party payment collection. XorPay is the primary channel; XunhuPay is the fallback.
XORPAY_AID=
XORPAY_APP_SECRET=
XORPAY_GATEWAY=https://xorpay.com/api/pay
XORPAY_NOTIFY_URL=
XORPAY_RETURN_URL=
XUNHUPAY_APPID=
XUNHUPAY_APPSECRET=
XUNHUPAY_GATEWAY=https://api.xunhupay.com/payment/do.html
XUNHUPAY_NOTIFY_URL=
XUNHUPAY_RETURN_URL=

# Legacy Alipay direct mode. Keep empty unless you intentionally use sandbox/direct Alipay.
ALIPAY_GATEWAY_MODE=sandbox
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
